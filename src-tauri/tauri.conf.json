{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist"
  },
  "package": {
    "productName": "PantherAgent",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "execute": false,
        "sidecar": true,
        "open": false
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://127.0.0.1:5050/*", "http://localhost:5050/*"]
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "Panther Agent Foundation",
      "deb": {
        "depends": []
      },
      "externalBin": [
        "binaries/panther_runtime"
      ],
      "icon": [],
      "identifier": "com.panther.agent",
      "longDescription": "Lightweight local desktop agent for low-resource Windows PCs.",
      "macOS": {},
      "resources": [],
      "shortDescription": "Panther Desktop Agent",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:5050 http://localhost:5050 http://127.0.0.1:3000; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline';"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 720,
        "resizable": true,
        "title": "Panther Agent",
        "width": 1100,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true
      }
    ]
  }
}
